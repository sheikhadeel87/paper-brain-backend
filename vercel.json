{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{src/**,node_modules/{multer,busboy,append-field,concat-stream,type-is,@google/generative-ai,inngest,cloudinary,bullmq,ioredis}/**}"
    }
  }
}
